{
  "name": "pilotseal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/assert-local-targets.mjs && npm run prepare:sky-art",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:local:start": "node scripts/start-local-supabase.mjs",
    "db:local:status": "node scripts/status-local-supabase.mjs",
    "predb:local:reset": "node scripts/assert-local-targets.mjs",
    "db:local:reset": "supabase db reset --local --network-id pilotseal-local",
    "db:local:stop": "supabase stop --network-id pilotseal-local",
    "env:local:sync": "node scripts/sync-local-supabase-env.mjs",
    "preseed:local": "node scripts/assert-local-targets.mjs",
    "seed:local": "node scripts/seed-local-supabase.mjs",
    "smoke:local": "node scripts/smoke-local-supabase.mjs",
    "pretest:db:local": "node scripts/assert-local-targets.mjs",
    "test:db:local": "supabase test db --local --network-id pilotseal-local supabase/tests",
    "test:schedule:local": "node scripts/test-cfi-schedule-drafts.mjs",
    "test:flight-brief": "node --test scripts/test-flight-brief-human-factors.mjs scripts/test-flight-brief-risk-model.mjs scripts/test-flight-brief-risk-flow.mjs scripts/test-flight-brief-risk-discussion.mjs",
    "test:schedule-ui:local": "node scripts/smoke-cfi-schedule-ui.mjs",
    "test:schedule-aircraft-ui:local": "node scripts/smoke-schedule-aircraft-ui.mjs",
    "test:aircraft-family": "node --experimental-strip-types --test scripts/test-aircraft-family.mjs",
    "test:aircraft-report-form": "node --test scripts/test-aircraft-report-form.mjs",
    "test:aircraft-reports:local": "node scripts/test-aircraft-reports-local.mjs",
    "test:record-groups": "node --test scripts/test-record-groups.mjs",
    "test:record-actions:local": "node scripts/test-record-actions-local.mjs",
    "test:local": "npm run db:local:start && npm run env:local:sync && npm run db:local:reset && npm run seed:local && npm run test:db:local && npm run test:schedule:local && npm run test:flight-brief && npm run smoke:local && npm run lint && npm run build",
    "check:production-deploy": "node scripts/assert-production-deploy.mjs",
    "audit:endorsements": "node scripts/audit-endorsements.mjs",
    "seed:endorsements:sql": "node scripts/export-endorsement-template-seed.mjs",
    "prepare:sky-art": "node scripts/prepare-sky-art.mjs",
    "test:sky-art": "tsx --test scripts/test-sky-art.ts",
    "prebuild": "npm run prepare:sky-art",
    "test:sky-art-ui:local": "node scripts/assert-local-targets.mjs && node scripts/test-sky-art-ui.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@supabase/supabase-js": "^2.99.0",
    "@types/three": "^0.183.1",
    "geographiclib-geodesic": "^2.2.0",
    "gray-matter": "^4.0.3",
    "idb-keyval": "^6.3.0",
    "luxon": "^3.7.2",
    "maplibre-gl": "^6.14.0",
    "marked": "^18.0.3",
    "next": "16.2.11",
    "opentype.js": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-modal": "^3.16.3",
    "recharts": "^3.8.0",
    "signature_pad": "^5.1.3",
    "suncalc": "^1.9.0",
    "three": "^0.183.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.12",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "supabase": "2.109.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  }
}
