{
  "name": "pilotseal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/assert-local-targets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:local:start": "node scripts/start-local-supabase.mjs",
    "db:local:status": "node scripts/status-local-supabase.mjs",
    "predb:local:reset": "node scripts/assert-local-targets.mjs",
    "db:local:reset": "supabase db reset --local --network-id pilotseal-local",
    "db:local:stop": "supabase stop --network-id pilotseal-local",
    "env:local:sync": "node scripts/sync-local-supabase-env.mjs",
    "preseed:local": "node scripts/assert-local-targets.mjs",
    "seed:local": "node scripts/seed-local-supabase.mjs",
    "smoke:local": "node scripts/smoke-local-supabase.mjs",
    "pretest:db:local": "node scripts/assert-local-targets.mjs",
    "test:db:local": "supabase test db --local --network-id pilotseal-local supabase/tests",
    "test:local": "npm run db:local:start && npm run env:local:sync && npm run db:local:reset && npm run seed:local && npm run test:db:local && npm run smoke:local && npm run lint && npm run build",
    "check:production-deploy": "node scripts/assert-production-deploy.mjs",
    "audit:endorsements": "node scripts/audit-endorsements.mjs",
    "seed:endorsements:sql": "node scripts/export-endorsement-template-seed.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@supabase/supabase-js": "^2.99.0",
    "@types/three": "^0.183.1",
    "gray-matter": "^4.0.3",
    "luxon": "^3.7.2",
    "marked": "^18.0.3",
    "next": "16.2.11",
    "pdf-lib": "^1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-modal": "^3.16.3",
    "recharts": "^3.8.0",
    "signature_pad": "^5.1.3",
    "suncalc": "^1.9.0",
    "three": "^0.183.2",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.12",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "supabase": "2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  }
